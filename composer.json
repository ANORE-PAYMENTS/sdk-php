{
  "name": "anore/sdk",
  "description": "Official ANORE payments SDK for PHP — payments, subscriptions and payouts.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://anore.cc/docs",
  "support": {
    "docs": "https://anore.cc/docs",
    "issues": "https://github.com/ANORE-PAYMENTS/sdk-php/issues",
    "source": "https://github.com/ANORE-PAYMENTS/sdk-php"
  },
  "keywords": ["anore", "payments", "subscriptions", "payouts", "sbp", "crypto", "payment-gateway"],
  "require": {
    "php": ">=7.4",
    "ext-curl": "*",
    "ext-json": "*",
    "symfony/polyfill-intl-idn": "^1.31",
    "symfony/polyfill-intl-normalizer": "^1.31",
    "symfony/polyfill-mbstring": "^1.31"
  },
  "autoload": {
    "psr-4": { "Anore\\": "src/" }
  }
}
